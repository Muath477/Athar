# Copy to .env and fill in. Never commit .env.
SADU_ENV=dev
SADU_PUBLIC_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=dev
S3_ACCESS_KEY_ID=devkey
S3_SECRET_ACCESS_KEY=devsecret123
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Models and speech. Without them every step uses its fallback (see README).
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Demo day: serve recorded model answers first (D3).
SADU_DEMO_MODE=false
SADU_DAILY_LLM_BUDGET_USD=10
SENTRY_DSN_API=

# Production profile only (Caddy with TLS). Files are served from files.<domain>.
SADU_DOMAIN=
